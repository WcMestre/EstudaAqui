# PROVISÓRIO: substituir pela implementação da issue [0.1]
# Copie para .env e ajuste. O .env NUNCA deve ser versionado.

# --- Banco (usado pelo docker-compose e pela API) ---
POSTGRES_USER=estudaaqui
POSTGRES_PASSWORD=estudaaqui
POSTGRES_DB=estudaaqui
DATABASE_URL=postgresql+psycopg://estudaaqui:estudaaqui@localhost:5432/estudaaqui
# Banco separado usado pelo pytest (criado automaticamente pelos testes)
DATABASE_URL_TESTE=postgresql+psycopg://estudaaqui:estudaaqui@localhost:5432/estudaaqui_teste

# --- Sessão (JWT) ---
# Gere um valor seu com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SEGREDO=troque-este-valor
JWT_EXPIRA_MINUTOS=30

# --- Front-end ---
FRONTEND_URL=http://localhost:3000

# --- E-mail (SMTP) — issue [1.2] ---
# Em desenvolvimento, o Mailpit do docker-compose (veja os e-mails em http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORTA=1025
SMTP_USUARIO=
SMTP_SENHA=
SMTP_STARTTLS=false
SMTP_SSL=false
EMAIL_REMETENTE=nao-responda@example.com
EMAIL_REMETENTE_NOME=EstudaAqui
# true = monta o e-mail mas não envia (os testes automatizados ligam sozinhos)
EMAIL_SUPRIMIR_ENVIO=false
